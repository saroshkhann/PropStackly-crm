# PropStackly CRM Backend Configuration
PROJECT_NAME="PropStackly CRM API"
VERSION="1.0.0"
API_V1_STR="/api/v1"

# Environment Mode: "development", "test", or "production"
# In development, an explicit development-only key is used if SECRET_KEY is omitted.
# In production, startup strictly fails if SECRET_KEY is missing, < 32 characters, or insecure.
ENVIRONMENT="development"

# Production: Set a secure 32+ character random secret (e.g. `openssl rand -hex 32`)
SECRET_KEY="replace_with_a_secure_random_key_in_production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Database Configuration
# PostgreSQL Production Example:
# DATABASE_URL="postgresql+psycopg://propstackly_user:propstackly_password@localhost:5432/propstackly_crm"
# Local Development Fallback:
DATABASE_URL="sqlite:///./propstackly_crm.db"

# CORS Origins (Comma-separated or list)
BACKEND_CORS_ORIGINS='["http://localhost:3000","http://127.0.0.1:3000"]'

# Email / SMTP Configuration for Password Reset
# In development or if unset, password reset emails are safely logged to console.
# In production, provide real SMTP credentials:
# SMTP_HOST="smtp.sendgrid.net"
# SMTP_PORT=587
# SMTP_USER="apikey"
# SMTP_PASSWORD="your-smtp-api-key"
# SMTP_TLS=True
EMAILS_FROM_EMAIL="noreply@propstackly.pk"
EMAILS_FROM_NAME="PropStackly CRM Security"
FRONTEND_URL="http://localhost:3000"
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=15

